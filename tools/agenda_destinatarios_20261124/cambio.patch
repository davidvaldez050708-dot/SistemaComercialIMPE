+    list-style: none;
+    cursor: pointer;
+    overflow-wrap: anywhere;
+}
+.agenda-comment-recipients summary::-webkit-details-marker {
+    display: none;
+}
+.agenda-comment-editor .agenda-comment-recipients[aria-disabled="true"] summary {
+    background: #f4f6fa;
