+        return ['segmentos'=>$overflow?[]:$ids,'audio_motivo'=>$reason,
+            'audio_evidencia'=>['referencias_propias'=>count($owned),'avisos_disponibilidad'=>count($ready),'referencias_ambiguas'=>$ambiguous]];
+    }
